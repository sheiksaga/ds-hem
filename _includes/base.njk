<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- support browser themeing -->
    <meta name="theme-color" content="#ffffff">
    <meta name="msapplication-navbutton-color" content="#ffffff">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="color-scheme" content="light dark">
    <!-- set the theme before first paint to avoid a flash of the wrong colours -->
    <script>
      (function () {
        try {
          var t = localStorage.getItem('ds-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <!-- title -->
    <title>{{ title }}</title>
    <!-- meta description for SEO -->
    <meta name="description" content="{{ description or 'Design Saga by Sangeeth Gandhi' }}">
    <!-- Open Graph tags for social sharing -->
    <meta property="og:title" content="{{ ogTitle or title }}">
    <meta property="og:description" content="{{ ogDescription or description or 'Design Saga by Sangeeth Gandhi' }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
    <!-- favicon -->
    <link rel="icon" type="image/x-icon" href="{{ '/src/img/favicon.ico' | url }}">
    <!-- Base styles (loaded on every page) -->
    <link rel="stylesheet" href="{{ '/src/css/main.css' | url }}">
    <link rel="stylesheet" href="{{ '/src/css/theme.css' | url }}">
    {% block css %}{% endblock %}
    <!-- quicklinks (dynamic load — skipped on file://) -->
    <script>
      if (window.location.protocol !== 'file:') {
        var ql = document.createElement('script');
        ql.src = 'https://unpkg.com/quicklink@2.3.0/dist/quicklink.umd.js';
        ql.defer = true;
        document.head.appendChild(ql);
        window.addEventListener('load', function() {
          try {
            if (typeof quicklink !== 'undefined') {
              quicklink.listen();
            }
          } catch (e) {}
        });
      }
    </script>
    {% block head %}{% endblock %}
</head>

<body>
    <!-- skip navigation link for accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <!-- theme toggle: peeking sphere, top-right -->
    <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false" aria-label="Switch to dark theme">
        <span class="theme-toggle__sphere" aria-hidden="true"></span>
    </button>
    <!-- header -->
    <header class="ds-header" id="header" data-component="site-header">
        {% block logo %}
        <a href="{{ '/' | url }}">
            <img class="logo-header" src="{{ '/src/img/design-saga-blue.svg' | url }}" alt="logo">
        </a>
        {% endblock %}
        <div class="menu">
            <ul class="nav-links">
                <li><a href="{{ '/' | url }}"{% if nav == 'home' %} class="active"{% endif %}>HOME</a></li>
                <li><a href="{{ '/projects/' | url }}"{% if nav == 'projects' %} class="active"{% endif %}>PROJECTS</a></li>
                <li><a href="{{ '/blog/' | url }}"{% if nav == 'blog' %} class="active"{% endif %}>BLOG</a></li>
            </ul>
        </div>
    </header>

    <div id="page-content">
    {% block content %}{% endblock %}

    <!-- back to top button -->

    <!-- footer -->
    <footer class="footer" data-component="site-footer">
        <div>
            {% block footer %}
            Built in GBG <br>
            Sangeeth, 2026
            {% endblock %}
        </div>
    </footer>
    </div>

    <!-- Shared scripts (loaded on every page) -->
    <script src="{{ '/src/js/main.js' | url }}"></script>
    <script src="{{ '/src/js/theme.js' | url }}"></script>
    {% block js %}{% endblock %}
</body>
</html>
