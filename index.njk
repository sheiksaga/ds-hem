          </p>
          <p style="margin-top: 1.5rem;">
            <a href="{{ '/projects/' | url }}">See all projects →</a>
          </p>
        
      </div>
    </section>

    <!-- services → accordion -->
    <section>
        <div class="box">
            <h2>What I do.</h2>
            <div class="accordion">
                <div class="accordion-item">
                    <button class="accordion-header" aria-expanded="false">
                        Web design
                        <span class="accordion-icon" aria-hidden="true"></span>
                    </button>
