        <ul>
            <li><span class="listspace">Instagram - <a href="https://www.instagram.com/sangeethg/" >SangeethG</a></span></li>
            <li><span class="listspace">E-mail - <span class="protected-email" data-user="gandhi.sangeeth" data-domain="gmail.com"></span></span></li>
            <li><span class="listspace">Linkedin - <a href="https://www.linkedin.com/in/sangeeth-gandhi/" rel="nofollow noopener">sangeeth-gandhi</a></span></li>
            <li><span class="listspace">Phone - <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" >( ͡° ͜ʖ ͡°)</a></span></li>
        </ul>
        </div>
        </div>
    </section>
{% endblock %}

{% block js %}
<script src="{{ '/assets/js/main.js' | url }}"></script>
<!-- Email obfuscation script -->
<script>
    (function() {
        document.querySelectorAll('.protected-email').forEach(function(el) {
            var user = el.dataset.user;
            var domain = el.dataset.domain;
            var email = user + '@' + domain;
            el.innerHTML = '<a href="mailto:' + email + '">' + email + '</a>';
        });
    })();
</script>
{% endblock %}
